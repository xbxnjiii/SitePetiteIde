# Modèle de configuration locale — copier en .dev.vars (jamais commité).
# En production, ces valeurs sont des SECRETS Cloudflare
# (Workers → sitepetiteide → Settings → Variables and Secrets), sauf indication.

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
# Chaîne aléatoire d'au moins 32 caractères (ex. : openssl rand -base64 48)
DOWNLOAD_TOKEN_SECRET=

# Variables simples (déjà définies dans wrangler.jsonc pour la production)
SITE_URL=http://127.0.0.1:8787
# false tant que l'URL des CGV n'est pas renseignée dans Stripe (Paramètres → Informations publiques)
STRIPE_TOS_CONSENT=false
STRIPE_AUTOMATIC_TAX=false
