{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sitepetiteide",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Auto-référence requise par OpenNext (doit correspondre au nom du Worker)
    { "binding": "WORKER_SELF_REFERENCE", "service": "sitepetiteide" }
  ],
  // Bucket PRIVÉ contenant les PDF vendus (à créer dans Cloudflare → R2 avant le déploiement)
  "r2_buckets": [{ "binding": "PDF_BUCKET", "bucket_name": "la-petite-ide-pdfs" }],
  // Variables non secrètes. Les secrets se règlent dans Cloudflare
  // (Workers → sitepetiteide → Settings → Variables and Secrets) :
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, RESEND_API_KEY, DOWNLOAD_TOKEN_SECRET
  "vars": {
    "SITE_URL": "https://lapetiteide.fr",
    "EMAIL_FROM": "La Petite IDE <commandes@lapetiteide.fr>",
    "EMAIL_REPLY_TO": "contact@lapetiteide.fr",
    "STRIPE_AUTOMATIC_TAX": "false"
  },
  "observability": { "enabled": true },

  // ==========================================================================
  //  PRÉPROD — https://preprod.lapetiteide.fr (Stripe en mode TEST)
  //  Déployée avec `--env preprod`. Les secrets se règlent sur le Worker
  //  sitepetiteide-preprod (clés Stripe sk_test_…, webhook de test, etc.).
  //  ⚠️ Dans un environnement Wrangler, vars / services / r2_buckets ne sont
  //  PAS hérités : tout est redéclaré ci-dessous.
  // ==========================================================================
  "env": {
    "preprod": {
      "name": "sitepetiteide-preprod",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "sitepetiteide-preprod" }],
      // Même bucket que la production : la préprod ne fait que lire les PDF.
      "r2_buckets": [{ "binding": "PDF_BUCKET", "bucket_name": "la-petite-ide-pdfs" }],
      "vars": {
        "SITE_URL": "https://preprod.lapetiteide.fr",
        "EMAIL_FROM": "La Petite IDE (préprod) <commandes@lapetiteide.fr>",
        "EMAIL_REPLY_TO": "contact@lapetiteide.fr",
        "STRIPE_AUTOMATIC_TAX": "false"
      },
      "observability": { "enabled": true }
    }
  }
}
